# ==============================================================================
# QUINTOS AI — ENVIRONMENT CONFIGURATION (.env.example)
# ==============================================================================
# Copy this file to .env.local for local development.
# NEVER commit .env, .env.local, or secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PUBLIC CLIENT-SIDE VARIABLES (Exposed to browser bundles)
# ------------------------------------------------------------------------------

# Application Base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Supabase Project URL (Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"

# Supabase Anonymous Public Key (Safe for browser clients, protected by RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key"


# ------------------------------------------------------------------------------
# 2. SERVER-ONLY SECRETS (NEVER expose to browser bundles or client code)
# ------------------------------------------------------------------------------

# Supabase Service Role Key (Bypasses RLS — Server-side administrative tasks only)
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key"

# PostgreSQL Database Connection URL (Prisma Connection Pooling / Supabase Pooler port 6543)
DATABASE_URL="postgresql://postgres.your-project-ref:[YOUR-PASSWORD]@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true"

# PostgreSQL Direct Connection URL (Prisma Migrations direct connection port 5432)
DIRECT_URL="postgresql://postgres.your-project-ref:[YOUR-PASSWORD]@aws-0-region.pooler.supabase.com:5432/postgres"

# Resend API Key for Transactional Emails (Phase 5B)
RESEND_API_KEY="re_123456789_your_resend_api_key"

# Internal Notification Email Recipient (Defaults to contact.quintosresearch@gmail.com)
CONTACT_NOTIFICATION_EMAIL="contact.quintosresearch@gmail.com"

# Verified Transactional Sender Address (e.g. "Quintos AI <inquiries@quintos.ai>")
FROM_EMAIL="Quintos AI <inquiries@quintos.ai>"

# AI Inference Provider Configuration (Phase 5D — SERVER-ONLY)
# Provider name: "gemini" (default) or "openai"
AI_PROVIDER="gemini"

# Default Model Identifier on the provider (e.g. "gemini-2.5-flash")
AI_MODEL="gemini-2.5-flash"

# Provider Secret API Key (SERVER-ONLY — Never prefix with NEXT_PUBLIC_)
AI_API_KEY=""

# Optional: Override Inference API Endpoint
# AI_API_ENDPOINT="https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:streamGenerateContent?alt=sse"

# Explicit Demonstration Mode Toggle (Set to true to force simulated responses)
AI_DEMO_MODE="false"

# Provider Request Timeout in Milliseconds
AI_REQUEST_TIMEOUT_MS="30000"

# AI Inference Rate Limiting (Requests per Window)
AI_RATE_LIMIT="20"
AI_RATE_WINDOW_SECONDS="60"


# ------------------------------------------------------------------------------
# 3. FUTURE INTEGRATIONS (Prepared for Phase 5E - 5F — DO NOT populate in 5D)
# ------------------------------------------------------------------------------
# STRIPE_SECRET_KEY=""
# STRIPE_WEBHOOK_SECRET=""
